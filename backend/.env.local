PORT=5000
MONGO_URI=
FRONTEND_URL=http://localhost:5173

# Secret used to sign login tokens. Change this to your own random string
# (never share it or commit a real one to a public repo).
JWT_SECRET=

# Comma-separated list of emails that get admin access.
# Whoever registers/logs in with one of these emails becomes an admin.
ADMIN_EMAILS=


# From Google Cloud Console > APIs & Services > Credentials.
# Must be the SAME value as VITE_GOOGLE_CLIENT_ID in the frontend .env.
GOOGLE_CLIENT_ID=

# The Gmail account that SENDS verification emails.
# EMAIL_PASS is a 16-character Gmail "App Password", NOT your normal
# Gmail password. Create one at: myaccount.google.com > Security >
# 2-Step Verification (must be on) > App passwords.
EMAIL_USER=
EMAIL_PASS=